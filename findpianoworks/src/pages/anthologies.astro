---
import Base from '../layouts/Base.astro';
import anthologies from '../data/anthologies.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const publishers = [...new Set(
  anthologies.map(a => a.publisher).filter(Boolean)
)].sort();

const selectStyle = 'color:#AD4C21; border:1px solid #b8a898; background:#F0EBE7; padding:2px 4px; font-family:inherit; font-size:11px;';
---
<Base title="Anthologies">
  <div class="panel">
    <div class="panel-head">Browse Anthologies</div>
    <div class="panel-body">

      <div style="display:flex; gap:12px; align-items:flex-end; margin-bottom:10px; flex-wrap:wrap;">
        <div>
          <label style="display:block; font-size:11px; color:#555; margin-bottom:2px;">Search by title</label>
          <input type="search" id="q" placeholder="Anthology name…" style={`${selectStyle} width:200px;`} />
        </div>
        <div>
          <label style="display:block; font-size:11px; color:#555; margin-bottom:2px;">Publisher</label>
          <select id="pub" style={selectStyle}>
            <option value="">— All —</option>
            {publishers.map(p => <option value={p}>{p}</option>)}
          </select>
        </div>
        <span id="rh" style="font-size:11px; color:#888;"></span>
      </div>

      <div id="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:8px;"></div>

    </div>
  </div>
</Base>

<script define:vars={{ anthologies, base }}>
  function n(s) { return (s ?? '').toLowerCase(); }

  function render(items) {
    document.getElementById('rh').textContent =
      items.length + ' antholog' + (items.length !== 1 ? 'ies' : 'y');
    document.getElementById('grid').innerHTML = items.map(a => {
      const editorLine = (a.editors || [])
        .filter(e => e.role === 'Editor' || e.role === 'Author')
        .map(e => e.name).join(', ');
      const cover = a.coverImage && !a.coverImage.includes('blankcoverart')
        ? `<img src="${a.coverImage}" alt="${a.title} cover"
               style="width:100%; height:100px; object-fit:contain; background:#fff; display:block;"
               onerror="this.style.display='none'" />`
        : `<div style="width:100%; height:60px; background:#e8ddd6; display:flex; align-items:center; justify-content:center;">
             <span style="font-size:10px; color:#888;">No cover</span></div>`;
      return `
        <a href="${base}/anthology/${a.id}"
           style="display:block; background:#F0EBE7; border:1px solid #c7b8a4; border-top:3px solid #a0907e;
                  text-decoration:none; color:inherit; transition:border-color 0.15s;"
           onmouseover="this.style.borderColor='#AD4C21'"
           onmouseout="this.style.borderColor='#c7b8a4'; this.style.borderTopColor='#a0907e'">
          ${cover}
          <div style="padding:5px 7px;">
            <div style="font-weight:bold; font-size:11px; color:#D96B11; line-height:1.3;">${a.title ?? ''}</div>
            ${editorLine ? `<div style="font-size:10px; color:#666; margin-top:1px;">${editorLine}</div>` : ''}
            ${a.publisher ? `<div style="font-size:10px; color:#999;">${a.publisher}</div>` : ''}
            <div style="font-size:10px; color:#AD4C21; margin-top:3px;">${(a.works || []).length} works</div>
          </div>
        </a>
      `;
    }).join('');
  }

  function doFilter() {
    const q   = n(document.getElementById('q').value);
    const pub = n(document.getElementById('pub').value);
    const res = anthologies.filter(a => {
      if (q && !n(a.title).includes(q)) return false;
      if (pub && n(a.publisher) !== pub) return false;
      return true;
    }).sort((a, b) => (a.title ?? '').localeCompare(b.title ?? ''));
    render(res);
  }

  render([...anthologies].sort((a, b) => (a.title ?? '').localeCompare(b.title ?? '')));
  document.getElementById('q').addEventListener('input', doFilter);
  document.getElementById('pub').addEventListener('change', doFilter);
</script>
