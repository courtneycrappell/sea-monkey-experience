---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="findpianoworks.com">
  <div style="display:flex; gap:12px; align-items:flex-start;">

    <!-- Left: main search panel -->
    <div style="flex:1; min-width:0;">
      <div class="panel">
        <div class="panel-body">
          <h1>Welcome!</h1>

          <p style="font-style:italic; color:#666; border-left:3px solid #c7b8a4; padding-left:10px; margin-bottom:14px; line-height:1.6;">
            This site is shared here as an archive — and mostly for sentimental reasons. Around 2005,
            a friend and I had a conversation that went something like: <em>"Wouldn't it be
            nice if there was a website that could catalog all piano music and be searchable by level,
            technique, mood, and all sorts of other criteria? We should just build that this
            weekend!"</em> It was a wonderfully naïve thought. With the technology and resources
            available at the time, what we were imagining was nearly impossible to build well — and
            certainly too expensive to sustain. We did build it anyway, over many years and with a lot
            of help, and we're proud of what it became. But the world has moved on, and so have we.
            <br /><br />
            If you are a piano teacher looking for an actively maintained repertoire database, we
            warmly recommend visiting{' '}
            <a href="https://pianomusicdatabase.com/" target="_blank">pianomusicdatabase.com</a>.
          </p>

          <form action={`${base}/repertoire`} method="get" style="margin:10px 0 0;">
            <p>
              Type in partial information to search repertoire and anthologies.
              For guided searches try the
              <a href={`${base}/repertoire`}>Repertoire</a> or
              <a href={`${base}/anthologies`}>Anthologies</a> tabs above.
            </p>
            <div style="margin-top:8px;">
              <input type="search" name="q" size="32" placeholder="Composer, title, keyword…" />
              &nbsp;
              <button type="submit" class="btn">Find Works</button>
              &nbsp;
              <button type="reset" class="btn-secondary">Clear Form</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Right sidebar -->
    <div style="width:160px; flex-shrink:0;">
      <div class="panel">
        <div class="panel-head">Information</div>
        <div>
          <a href={`${base}/about`} class="sidebar-link">About</a>
          <a href={`${base}/methodology`} class="sidebar-link">Methodology</a>
          <a href={`${base}/acknowledgements`} class="sidebar-link">Acknowledgements</a>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">Links</div>
        <div>
          <a href="https://www.alfred.com" target="_blank" class="sidebar-link">Alfred Publishing</a>
          <a href="https://www.kjos.com" target="_blank" class="sidebar-link">Kjos Music</a>
          <a href="https://www.frederickharris.com" target="_blank" class="sidebar-link">Frederick Harris</a>
        </div>
      </div>
    </div>

  </div>
</Base>
