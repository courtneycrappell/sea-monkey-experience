---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Acknowledgements">
  <div class="grid md:grid-cols-3 gap-6">
    <div class="md:col-span-2 card space-y-4">
      <h1>Acknowledgements</h1>
      <p>
        findpianoworks.com was created by <strong>Courtney Crappell</strong> and
        <strong>Kimberly Dreisbach</strong>. The authors wish to thank all those who contributed
        to the development and data entry for this database over the years.
      </p>
      <p>
        Special thanks to the publishers who produce the anthologies catalogued here:
        Alfred Publishing Co., Inc.; Neil A. Kjos Music Company; and The Frederick Harris Music Co., Limited.
      </p>
    </div>
    <div class="card text-sm">
      <h3>Information</h3>
      <ul class="space-y-1">
        <li><a href={`${base}/about`}>About</a></li>
        <li><a href={`${base}/methodology`}>Methodology</a></li>
        <li><a href={`${base}/acknowledgements`}>Acknowledgements</a></li>
      </ul>
    </div>
  </div>
</Base>
