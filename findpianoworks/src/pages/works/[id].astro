---
import Base from '../../layouts/Base.astro';
import works from '../../data/works.json';

export function getStaticPaths() {
  return works.map(w => ({ params: { id: String(w.id) } }));
}

const { id } = Astro.params;
const work = works.find(w => String(w.id) === id)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const incipitSrc = work.incipit && !work.incipit.includes('blankincipit')
  ? `${base}/images/${work.incipit.replace(/.*\/images\//, '')}`
  : null;

function field(label: string, value: string | null | undefined) {
  if (!value) return null;
  return { label, value };
}
const fields = [
  field('Level', work.level ?? null),
  field('Period', work.period),
  field('Key', work.keySig),
  field('Meter', work.meter),
  field('Genre', work.genre),
  field('Instrumentation', work.instrumentation),
  field('Tempo', work.tempo),
  field('Marked Tempo', work.markedTempo),
  field('Mood', work.mood),
  field('Occasion', work.occasion),
  field('Length (mm)', work.length),
  field('Collection', work.collection),
  field('Catalog Number', work.catalogNumber),
  field('Comments', work.comments),
].filter(Boolean) as { label: string; value: string }[];
---
<Base title={work.title ?? 'Work'}>
  <p style="margin-bottom:8px; font-size:11px;">
    <a href={`${base}/repertoire`}>&larr; Back to search</a>
  </p>

  <div style="display:flex; gap:12px; align-items:flex-start;">

    <!-- Main detail panel -->
    <div style="flex:1; min-width:0;">
      <div class="panel">
        <div class="panel-body">
          <h1>{work.title}</h1>
          <p style="margin-bottom:10px;">
            <a href={`${base}/repertoire?composerId=${work.composerId}`} style="font-weight:bold;">
              {work.composer}
            </a>
            {work.birthDate && work.deathDate && (
              <span style="color:#888;"> ({work.birthDate}–{work.deathDate})</span>
            )}
          </p>

          {incipitSrc && (
            <div style="margin-bottom:14px; text-align:center;">
              <img src={incipitSrc} alt={`Score excerpt: ${work.title}`}
                   style="max-width:100%; border:1px solid #c7b8a4; background:#fff;" />
            </div>
          )}

          <table style="border-collapse:collapse; width:100%; font-size:12px;">
            {fields.map(f => (
              <tr style="border-bottom:1px solid #e4ddd6;">
                <td style="font-weight:bold; color:#AD4C21; padding:3px 10px 3px 0; width:130px; vertical-align:top;">{f.label}</td>
                <td style="padding:3px 0; color:#333;">{f.value}</td>
              </tr>
            ))}
          </table>
        </div>
      </div>

      {work.techniques && work.techniques.length > 0 && (
        <div class="panel">
          <div class="panel-head">Techniques</div>
          <div class="panel-body" style="padding-top:8px;">
            {work.techniques.map(t => <span class="tag">{t}</span>)}
          </div>
        </div>
      )}

      {work.rhythms && work.rhythms.length > 0 && (
        <div class="panel">
          <div class="panel-head">Rhythmic Elements</div>
          <div class="panel-body" style="padding-top:8px;">
            {work.rhythms.map(r => <span class="tag">{r}</span>)}
          </div>
        </div>
      )}
    </div>

    <!-- Sidebar -->
    <div style="width:160px; flex-shrink:0;">

      <div class="panel">
        <div class="panel-head">Composer</div>
        <div class="panel-body" style="font-size:11px;">
          <p style="font-weight:bold; margin-bottom:2px;">{work.composer}</p>
          {work.birthDate && (
            <p style="color:#666;">b. {work.birthDate}{work.deathDate ? ` — d. ${work.deathDate}` : ''}</p>
          )}
          {work.period && <p style="color:#666;">{work.period}{work.country ? ` · ${work.country}` : ''}</p>}
          <a href={`${base}/repertoire?composerId=${work.composerId}`} style="font-size:11px; display:block; margin-top:6px;">
            All works by this composer →
          </a>
        </div>
      </div>

      {work.sources && work.sources.length > 0 && (
        <div class="panel">
          <div class="panel-head">Found In</div>
          <div>
            {work.sources.map(s => (
              <div style="font-size:11px; padding:3px 10px; border-bottom:1px solid #e4ddd6; color:#333;">{s}</div>
            ))}
          </div>
        </div>
      )}
    </div>

  </div>
</Base>
