---
import Base from '../../layouts/Base.astro';
import anthologies from '../../data/anthologies.json';

export function getStaticPaths() {
  return anthologies.map(a => ({ params: { id: String(a.id) } }));
}

const { id } = Astro.params;
const anthology = anthologies.find(a => String(a.id) === id)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const editors = (anthology.editors ?? []).filter(e => e.role === 'Editor' || e.role === 'Author');

const coverSrc = anthology.coverImage && !anthology.coverImage.includes('blankcoverart')
  ? `${base}/images/${anthology.coverImage.replace(/.*\/images\//, '')}`
  : null;
const sortedWorks = [...(anthology.works ?? [])].sort((a, b) =>
  (a.composer ?? '').localeCompare(b.composer ?? '') ||
  (a.title ?? '').localeCompare(b.title ?? '')
);
---
<Base title={anthology.title ?? 'Anthology'}>
  <p style="margin-bottom:8px; font-size:11px;">
    <a href={`${base}/anthologies`}>&larr; Back to anthologies</a>
  </p>

  <div style="display:flex; gap:12px; align-items:flex-start;">

    <!-- Work list panel -->
    <div style="flex:1; min-width:0;">
      <div class="panel">
        <div class="panel-head">
          {anthology.title}
          {editors.length > 0 && (
            <span style="font-weight:normal; font-size:11px; color:#5a4a3a; margin-left:8px;">
              ed. {editors.map(e => e.name).join(', ')}
            </span>
          )}
        </div>
        <div class="panel-body" style="padding:0;">
          <div style="padding:6px 15px 4px; font-size:11px; color:#888; border-bottom:1px solid #e4ddd6;">
            {sortedWorks.length} works
          </div>
          {sortedWorks.map(w => (
            <div style="display:flex; align-items:baseline; justify-content:space-between; gap:8px;
                        padding:5px 15px; border-bottom:1px solid #ece5de;">
              <div style="flex:1; min-width:0;">
                <span style="font-weight:bold; color:#D96B11; font-size:12px;">{w.title}</span>
                <span style="color:#888; font-size:11px; margin-left:6px;">{w.composer}</span>
                {w.catalogNumber && <span style="color:#bbb; font-size:11px;">, {w.catalogNumber}</span>}
                <span style="display:inline-block; margin-left:4px;">
                  {w.level && <span class="tag">Level {w.level}</span>}
                  {w.period && <span class="tag">{w.period}</span>}
                </span>
              </div>
              <a href={`${base}/works/${w.id}`} style="font-size:11px; flex-shrink:0;">View →</a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div style="width:160px; flex-shrink:0;">

      {coverSrc && (
        <div class="panel">
          <div style="padding:6px; background:#F0EBE7; text-align:center;">
            <img src={coverSrc} alt={`${anthology.title} cover`}
                 style="max-width:100%; max-height:180px; object-fit:contain;"
                 onerror="this.closest('.panel').style.display='none'" />
          </div>
        </div>
      )}

      <div class="panel">
        <div class="panel-head">Details</div>
        <div class="panel-body" style="font-size:11px; padding-top:6px;">
          {anthology.publisher && (
            <p><span style="font-weight:bold; color:#AD4C21;">Publisher:</span><br />{anthology.publisher}</p>
          )}
          {anthology.pubDateOrig && (
            <p><span style="font-weight:bold; color:#AD4C21;">First published:</span><br />{anthology.pubDateOrig}</p>
          )}
          {anthology.bookType && (
            <p><span style="font-weight:bold; color:#AD4C21;">Type:</span> {anthology.bookType}</p>
          )}
          {anthology.companionCD && (
            <p style="color:#4a7c59; font-weight:bold;">Includes companion CD</p>
          )}
          {anthology.comments && (
            <p style="color:#666; margin-top:6px;">{anthology.comments}</p>
          )}
        </div>
      </div>

    </div>
  </div>
</Base>
