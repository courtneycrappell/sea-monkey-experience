---
import Base from '../layouts/Base.astro';
import techniques from '../data/lookup/techniques.json';
import techniqueExamples from '../data/technique-examples.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const families: Record<string, string[]> = {};
for (const t of techniques) {
  const dash = t.label.indexOf(' - ');
  const family = dash >= 0 ? t.label.slice(0, dash) : 'Other';
  const specific = dash >= 0 ? t.label.slice(dash + 3) : t.label;
  (families[family] ??= []).push(specific);
}
const familyNames = Object.keys(families).sort();

function exampleHref(family: string, specific: string): string {
  // Techniques without a ' - ' separator land in family='Other'; their label IS the specific
  const label = family === 'Other' ? specific : `${family} - ${specific}`;
  const workId = (techniqueExamples as Record<string, number | null>)[label];
  if (workId != null) {
    return `${base}/works/${workId}`;
  }
  // fallback to search for techniques with no example work in database
  return `${base}/repertoire?technique=${encodeURIComponent(label)}`;
}
---
<Base title="Methodology">
  <div style="display:flex; gap:12px; align-items:flex-start;">

    <div style="flex:1; min-width:0;">
      <div class="panel">
        <div class="panel-body">
          <h1>Methodology</h1>

          <h2>Leveling</h2>
          <p>
            Difficulty levels for repertoire are indicated using numbers 1–10. This approach was
            modeled after the system found in <em>The Pianist's Guide to Standard Teaching and
            Performance Literature</em> by Jane Magrath.
          </p>

          <h2>Techniques</h2>
          <p>
            In an effort to create the most intuitive list, individual techniques are found within
            an umbrella category. For example, the technique "staccato" is found under the umbrella
            category "articulation." The technique "left-hand melody" is found under the category
            "voicing." A complete list of techniques with links to examples appears below.
          </p>
          <p>
            In our database, techniques are associated with a work if they are significant to the
            search for repertoire. We determined that teachers would want to search by techniques for
            two reasons: (1) the technique is a new hurdle for the student or (2) the technique
            pervades a work.
          </p>

          <h2>Technique Families:</h2>
          <p>
            {familyNames.map((f, i) => (
              <>
                <a href={`#${f.replace(/\s+/g, '-')}`}>{f}</a>
                {i < familyNames.length - 1 && <br />}
              </>
            ))}
          </p>

          <h2>Complete Technique List:</h2>
          {familyNames.map(f => (
            <div style="margin-bottom:12px;">
              <h3 id={f.replace(/\s+/g, '-')}>{f}</h3>
              <p>
                {families[f].map((t, i) => (
                  <>
                    <a href={exampleHref(f, t)}>{f} — {t}</a>
                    {i < families[f].length - 1 && <br />}
                  </>
                ))}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div style="width:160px; flex-shrink:0;">
      <div class="panel">
        <div class="panel-head">Information</div>
        <div>
          <a href={`${base}/about`} class="sidebar-link">About</a>
          <a href={`${base}/methodology`} class="sidebar-link">Methodology</a>
          <a href={`${base}/acknowledgements`} class="sidebar-link">Acknowledgements</a>
        </div>
      </div>
      <div class="panel">
        <div class="panel-head">Level Scale</div>
        <div class="panel-body" style="padding-top:6px;">
          {['Primer/Early Elem.','Elementary','Late Elementary','Early Intermediate',
            'Intermediate','Late Intermediate','Early Advanced','Advanced',
            'Late Advanced','Concert/Collegiate'].map((l, i) => (
            <div style="font-size:11px; padding:2px 0; border-bottom:1px solid #ddd4c8;">
              <strong style="color:#AD4C21;">{i+1}</strong> — {l}
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</Base>
