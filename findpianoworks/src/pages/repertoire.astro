---
import Base from '../layouts/Base.astro';
import composers from '../data/composers.json';
import levels from '../data/lookup/levels.json';
import periods from '../data/lookup/periods.json';
import techniques from '../data/lookup/techniques.json';
import moods from '../data/lookup/moods.json';
import occasions from '../data/lookup/occasions.json';
import genres from '../data/lookup/genres.json';
import keysigs from '../data/lookup/keysigs.json';
import instrumentation from '../data/lookup/instrumentation.json';
import works from '../data/works.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const techniqueFamilies = [...new Set(
  techniques.map(t => t.label.split(' - ')[0])
)].sort();

const labelStyle = 'display:block; font-size:11px; color:#555; margin-bottom:2px; margin-top:6px;';
const selectStyle = 'width:100%; color:#AD4C21; border:1px solid #b8a898; background:#F0EBE7; padding:2px 3px; font-family:inherit; font-size:11px;';
---
<Base title="Repertoire Search">
  <div style="display:flex; gap:12px; align-items:flex-start;">

    <!-- Filter panel (left) -->
    <div style="width:175px; flex-shrink:0;">
      <form id="sf">
        <div class="panel">
          <div class="panel-head">Basic Search</div>
          <div class="panel-body" style="padding-top:6px;">

            <label style={labelStyle} for="q">Search</label>
            <input type="search" id="q" placeholder="Title or composer…" style={selectStyle} />

            <label style={labelStyle} for="composerId">Composer</label>
            <select id="composerId" style={selectStyle}>
              <option value="">— Select —</option>
              {composers.map(c => <option value={String(c.id)}>{c.name}</option>)}
            </select>

            <label style={labelStyle}>Level range</label>
            <div style="display:flex; gap:4px; align-items:center;">
              <select id="levelMin" style={selectStyle}>
                <option value="">—</option>
                {levels.map(l => <option value={String(l.id)}>{l.label}</option>)}
              </select>
              <span style="font-size:11px; color:#888;">–</span>
              <select id="levelMax" style={selectStyle}>
                <option value="">—</option>
                {levels.map(l => <option value={String(l.id)}>{l.label}</option>)}
              </select>
            </div>

            <label style={labelStyle} for="period">Period</label>
            <select id="period" style={selectStyle}>
              <option value="">— Select —</option>
              {periods.map(p => <option value={p.label}>{p.label}</option>)}
            </select>

            <hr style="margin:10px 0; border-bottom:1px dashed #c7b8a4;" />

            <label style={labelStyle} for="techFamily">Technique family</label>
            <select id="techFamily" style={selectStyle}>
              <option value="">— Select —</option>
              {techniqueFamilies.map(f => <option value={f}>{f}</option>)}
            </select>

            <label style={labelStyle} for="technique">Specific technique</label>
            <select id="technique" style={selectStyle}>
              <option value="">— Select —</option>
              {techniques.map(t => <option value={t.label}>{t.label}</option>)}
            </select>

            <label style={labelStyle} for="mood">Mood</label>
            <select id="mood" style={selectStyle}>
              <option value="">— Select —</option>
              {moods.map(m => <option value={m.label}>{m.label}</option>)}
            </select>

            <label style={labelStyle} for="occasion">Occasion</label>
            <select id="occasion" style={selectStyle}>
              <option value="">— Select —</option>
              {occasions.map(o => <option value={o.label}>{o.label}</option>)}
            </select>

            <label style={labelStyle} for="genre">Genre</label>
            <select id="genre" style={selectStyle}>
              <option value="">— Select —</option>
              {genres.map(g => <option value={g.label}>{g.label}</option>)}
            </select>

            <label style={labelStyle} for="keySig">Key signature</label>
            <select id="keySig" style={selectStyle}>
              <option value="">— Select —</option>
              {keysigs.map(k => <option value={k.label}>{k.label}</option>)}
            </select>

            <label style={labelStyle} for="instrumentation">Instrumentation</label>
            <select id="instrumentation" style={selectStyle}>
              <option value="">— Select —</option>
              {instrumentation.map(i => <option value={i.label}>{i.label}</option>)}
            </select>

            <div style="margin-top:10px; display:flex; gap:4px;">
              <button type="submit" class="btn" style="flex:1;">Find Works</button>
              <button type="button" id="clearBtn" class="btn-secondary">Clear</button>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Results panel (right) -->
    <div style="flex:1; min-width:0;">
      <div class="panel">
        <div class="panel-head" id="rh">Search Results</div>
        <div class="panel-body" style="padding:0;">
          <div id="rl"></div>
        </div>
      </div>
    </div>

  </div>
</Base>

<script define:vars={{ works, base }}>
  function n(s) { return (s ?? '').toLowerCase(); }

  function render(ws) {
    document.getElementById('rh').textContent =
      ws.length + ' work' + (ws.length !== 1 ? 's' : '') + ' found';
    if (!ws.length) {
      document.getElementById('rl').innerHTML =
        '<p style="padding:12px 15px; color:#888;">No results match your criteria.</p>';
      return;
    }
    document.getElementById('rl').innerHTML = ws.map(w => `
      <div class="result-row" style="padding:6px 15px; display:flex; align-items:baseline; gap:8px; border-bottom:1px solid #ddd4c8;">
        <div style="flex:1; min-width:0;">
          <span style="font-weight:bold; color:#D96B11;">${w.title ?? '(untitled)'}</span>
          <span style="color:#888; font-size:11px; margin-left:6px;">${w.composer ?? ''}</span>
          ${w.catalogNumber ? `<span style="color:#aaa; font-size:11px;">, ${w.catalogNumber}</span>` : ''}
          <div style="margin-top:2px;">
            ${w.level ? `<span class="tag">Level ${w.level}</span>` : ''}
            ${w.period ? `<span class="tag">${w.period}</span>` : ''}
            ${w.keySig ? `<span class="tag">${w.keySig}</span>` : ''}
            ${(w.techniques || []).slice(0, 2).map(t => `<span class="tag">${t}</span>`).join('')}
          </div>
        </div>
        <a href="${base}/works/${w.id}" class="btn btn-sm" style="flex-shrink:0;">View</a>
      </div>
    `).join('');
  }

  function getVal(id) { return document.getElementById(id).value; }

  function doFilter() {
    const q          = n(getVal('q'));
    const composerId = getVal('composerId');
    const lMin       = parseInt(getVal('levelMin')) || 0;
    const lMax       = parseInt(getVal('levelMax')) || 99;
    const period     = n(getVal('period'));
    const tf         = n(getVal('techFamily'));
    const tech       = n(getVal('technique'));
    const mood       = n(getVal('mood'));
    const occ        = n(getVal('occasion'));
    const genre      = n(getVal('genre'));
    const key        = n(getVal('keySig'));
    const instr      = n(getVal('instrumentation'));

    const res = works.filter(w => {
      if (q && !n(w.title).includes(q) && !n(w.composer).includes(q) && !n(w.catalogNumber).includes(q)) return false;
      if (composerId && String(w.composerId) !== composerId) return false;
      if (lMin && (w.levelId || 0) < lMin) return false;
      if (lMax < 99 && (w.levelId || 0) > lMax) return false;
      if (period && n(w.period) !== period) return false;
      if (tf && !(w.techniques || []).some(t => n(t).startsWith(tf.toLowerCase()))) return false;
      if (tech && !(w.techniques || []).some(t => n(t) === tech)) return false;
      if (mood && n(w.mood) !== mood) return false;
      if (occ && n(w.occasion) !== occ) return false;
      if (genre && n(w.genre) !== genre) return false;
      if (key && n(w.keySig) !== key) return false;
      if (instr && n(w.instrumentation) !== instr) return false;
      return true;
    }).sort((a, b) => {
      const c = (a.composer || '').localeCompare(b.composer || '');
      return c || (a.title || '').localeCompare(b.title || '');
    });

    render(res);
  }

  render(works);
  document.getElementById('sf').addEventListener('submit', e => { e.preventDefault(); doFilter(); });
  document.getElementById('sf').addEventListener('change', doFilter);
  document.getElementById('clearBtn').addEventListener('click', () => {
    document.getElementById('sf').reset();
    doFilter();
  });

  const qp = new URLSearchParams(location.search).get('q');
  if (qp) { document.getElementById('q').value = qp; doFilter(); }

  const tp = new URLSearchParams(location.search).get('technique');
  if (tp) { document.getElementById('technique').value = tp; doFilter(); }

  const cp = new URLSearchParams(location.search).get('composerId');
  if (cp) { document.getElementById('composerId').value = cp; doFilter(); }
</script>
