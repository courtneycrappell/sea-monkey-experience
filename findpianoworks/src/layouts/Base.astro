---
export interface Props {
  title?: string;
}
const { title = 'findpianoworks.com' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}/`,             label: 'Home' },
  { href: `${base}/repertoire`,   label: 'Repertoire' },
  { href: `${base}/anthologies`,  label: 'Anthologies' },
  { href: `${base}/about`,        label: 'About' },
];
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="A searchable database of piano teaching repertoire and anthologies." />
  <title>{title === 'findpianoworks.com' ? title : `${title} — findpianoworks.com`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
</head>
<body class="min-h-screen flex flex-col">
  <!-- Header -->
  <header class="bg-fpw-darkblue text-white shadow-md">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href={`${base}/`} class="text-xl font-bold tracking-tight text-white hover:no-underline hover:text-fpw-lightblue">
        findpianoworks.com
      </a>
      <nav>
        <ul class="flex gap-1">
          {nav.map(n => (
            <li>
              <a
                href={n.href}
                class={`px-3 py-1.5 rounded text-sm font-medium transition-colors
                  ${currentPath === n.href || currentPath.startsWith(n.href + '/')
                    ? 'bg-white text-fpw-darkblue'
                    : 'text-white hover:bg-fpw-blue'}`}
              >
                {n.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main class="flex-1 max-w-5xl mx-auto px-4 py-6 w-full">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-fpw-border bg-white text-center text-xs text-gray-500 py-3">
    &copy; Copyright
    <a href="mailto:courtneycrappell@yahoo.com">Courtney Crappell &amp; Kimberly Dreisbach</a>
    &nbsp;·&nbsp;
    <a href={`${base}/about`}>About</a> &nbsp;·&nbsp;
    <a href={`${base}/methodology`}>Methodology</a> &nbsp;·&nbsp;
    <a href={`${base}/acknowledgements`}>Acknowledgements</a>
  </footer>
</body>
</html>
